{
  "name": "\u200b",
  "short_name": "봄의 정원",
  "description": "형·윈터·봇이 같이 쓰는 봄의 정원",
  "lang": "ko",
  "id": "/office-app/",
  "start_url": "/garden-app/",
  "scope": "/garden-app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#040303",
  "theme_color": "#040303",
  "share_target": {
    "action": "/garden-app/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/garden-app/icon-splash-192.png?v=sprout1116",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/garden-app/icon-splash-512.png?v=sprout1116",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/garden-app/icon-maskable-512.png?v=peach1114",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
